# 開発用のイメージ。ui と同じく Node.js 26 の軽い Debian をもとにする。
FROM docker.io/library/node:26-slim

# nest start --watch は、作り直す前に古いプロセスを ps で探して止める。
# slim のイメージには ps が無いので procps を入れる（無いと EADDRINUSE で落ちる）。
RUN apt-get update \
  && apt-get install -y --no-install-recommends procps \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 依存を先に入れて、ソースだけの変更ではキャッシュを使う。
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3001
CMD ["npm", "run", "start:dev"]
