{
  "name": "my-app",
  "private": true,
  "description": "openapi.yaml を扱う道具と、E2E テスト（frontend と bff はそれぞれの package.json を使う）",
  "scripts": {
    "lint:api": "redocly lint openapi.yaml",
    "generate:api": "openapi-typescript --default-non-nullable false",
    "check:api": "openapi-typescript --default-non-nullable false --check",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@redocly/cli": "^2.79.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
