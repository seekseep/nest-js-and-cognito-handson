# 開発用のイメージ。Node.js 26 の入った軽い Debian をもとにする。
FROM docker.io/library/node:26-slim

WORKDIR /app

# 先に package*.json だけをコピーして依存を入れる。
# ソースだけを変えたときは、この層がキャッシュから使われて npm ci が走らない。
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
