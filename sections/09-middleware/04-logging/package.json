{
  "name": "my-app",
  "private": true,
  "description": "openapi.yaml を扱う道具（ui と api はそれぞれの package.json を使う）",
  "scripts": {
    "lint:api": "redocly lint openapi.yaml",
    "generate:api": "openapi-typescript --default-non-nullable false",
    "check:api": "openapi-typescript --default-non-nullable false --check"
  },
  "devDependencies": {
    "@redocly/cli": "^2.79.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
